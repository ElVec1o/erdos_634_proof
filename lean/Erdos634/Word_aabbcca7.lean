/-- Node 1: 1 placed tile(s), `v = (6, 0)`, `d = (1, 0)`; kills: child 2, baseword, escape(Q, edge 2), escape(Q, edge 2), baseword, baseword. -/
theorem node_1 {N : ℕ} (D : CongruentDissection N)
    (htarget : D.target.carrier = TGT.carrier) (hmodel : D.model.Congruent MODEL) (hbase : BaseWordHyp D.toDissection)

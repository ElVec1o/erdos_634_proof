  obtain ⟨j, hj, k₀, k₁, k₂, hk01, hk02, hk12, hk₀, ⟨c', hc', hk₁⟩, hk₂⟩ :=
    placement_completeness D.toDissection ([i0] : List (Fin N)).toFinset (rp 32 6 0) (rp 32 1 0) (rp_unit hD32 (by norm_num)) hlex hfree hblocked

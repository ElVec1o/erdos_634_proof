      rp 32 6 0 + t • (rp 32 1 0 + s • perp (rp 32 1 0)) ∈ unfilled D.toDissection ([i0] : List (Fin N)).toFinset := by
    refine hfree_of hD32 (B := 6) (by norm_num) sr32_lt (τ := (1/4)) (by norm_num) _ _ _ ?_

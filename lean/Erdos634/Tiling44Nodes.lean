/-- Node 0: 0 placed tile(s), `v = (0, 0)`, `d = (1, 0)`; kills: child None, child None, escape(Q, edge 2), escape(Q, edge 2), child None, child None. -/
theorem node_0 {N : ℕ} (D : CongruentDissection N)
    (htarget : D.target.carrier = TGT.carrier) (hmodel : D.model.Congruent MODEL)
    : ∃ j, j ∉ ([] : List (Fin N)).toFinset ∧ ((D.tile j).carrier = T0.carrier ∨ (D.tile j).carrier = T1.carrier ∨ (D.tile j).carrier = T2.carrier ∨ (D.tile j).carrier = T3.carrier) := by
  classical
  have hyT : ∀ p ∈ TGT.carrier, 0 ≤ p 1 := fun p hp => target_y_nonneg hD15 (by norm_num) TGT_pos hp
  have hU : ∀ p, p ∈ unfilled D.toDissection ([] : List (Fin N)).toFinset ↔ p ∈ TGT.carrier := by
    intro p; rw [mem_unfilled_iff, htarget]
    simp []
  have hlex : ∀ p ∈ closure (unfilled D.toDissection ([] : List (Fin N)).toFinset), LexLE (rp 15 0 0) p := by
    refine hlex_of D.toDissection _ _ ((TGT.carrier ∩ halfR 15 0 1 0) ∩ (halfR 15 1 0 0)) ((TGT.isCompact.isClosed.inter (isClosed_halfR _ _ _ _)).inter (isClosed_halfR _ _ _ _)) ?_ ?_
    · intro p hpT hnot
      obtain ⟨X, Y, rfl⟩ := exists_rp hD15 p
      have hpT' : rp 15 X Y ∈ TGT.carrier := htarget ▸ hpT
      obtain ⟨hT0, hT1, hT2⟩ := rtri_ef_nonneg hD15 TGT_pos hpT'
      unfold ef at hT0 hT1 hT2
      have hY : 0 ≤ Y := by
        by_contra hR; push_neg at hR
        linarith
      simp only [Set.mem_inter_iff, Set.mem_union, mem_halfR_rp hD15]
      refine ⟨⟨hpT', by linarith⟩, ?_⟩
      rcases le_or_gt 0 X with hX | hX
      · exact (by linarith)
      · -- the region X < xv, Y ≥ yv
        exfalso; linarith
    · intro p hp
      obtain ⟨X, Y, rfl⟩ := exists_rp hD15 p
      simp only [Set.mem_inter_iff, Set.mem_union, mem_halfR_rp hD15] at hp
      obtain ⟨⟨hpT, hY⟩, hdis⟩ := hp
      obtain ⟨hT0, hT1, hT2⟩ := rtri_ef_nonneg hD15 TGT_pos hpT
      unfold ef at hT0 hT1 hT2
      refine lexLE_rp hD15 (by linarith) (fun hYe => ?_)
      rcases hdis with h <;> linarith
  have hfree : ∀ ε : ℝ, 0 < ε → ∃ t s : ℝ, 0 < t ∧ t < ε ∧ 0 < s ∧ s < ε ∧
      rp 15 0 0 + t • (rp 15 1 0 + s • perp (rp 15 1 0)) ∈ unfilled D.toDissection ([] : List (Fin N)).toFinset := by
    refine hfree_of hD15 (B := 4) (by norm_num) sr15_lt (τ := (1/4)) (by norm_num) _ _ _ ?_
    intro t ht htτ
    rw [pt_ccw_rp 15 hD15, hU]
    have ht2 : t ^ 2 ≤ (1/4) * t := by nlinarith [mul_le_mul_of_nonneg_left htτ ht.le]
    have ht2p : 0 < t ^ 2 := by positivity
    exact mem_rtri hD15 TGT_pos (by unfold ef; linarith) (by unfold ef; linarith) (by unfold ef; linarith)
  have hblocked : ∃ δ : ℝ, 0 < δ ∧ ∀ t s : ℝ, 0 < t → t < δ → 0 < s → s < δ →
      rp 15 0 0 + t • (rp 15 1 0 - s • perp (rp 15 1 0)) ∉ unfilled D.toDissection ([] : List (Fin N)).toFinset := by
    exact hblocked_base hD15 D.toDissection _ (fun p hp => hyT p (htarget ▸ hp)) 0
  obtain ⟨j, hj, k₀, k₁, k₂, hk01, hk02, hk12, hk₀, ⟨c', hc', hk₁⟩, hk₂⟩ :=
    placement_completeness D.toDissection ([] : List (Fin N)).toFinset (rp 15 0 0) (rp 15 1 0) (rp_unit hD15 (by norm_num)) hlex hfree hblocked
  have hcong : (D.tile j).Congruent MODEL := (D.tiles_congruent j).trans hmodel
  obtain ⟨hMa, hMb, hMc⟩ := MODEL_sides
  rcases six_placements hcong hMa hMb hMc (rp_unit hD15 (by norm_num)) hk01 hk02 hk12 hk₀ hc' hk₁ hk₂ with
    ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩
  · -- placement 1: (16, 32, 24)
    have hP' : (D.tile j).pts k₁ = rp 15 16 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 22 6 := by
      rw [hQ, placeThird_rp hD15 0 0 1 0 16 32 24 22 6 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    have hjc : (D.tile j).carrier = T0.carrier :=
      carrier_eq_rtri_of_pts hD15 _ hk01 hk02 hk12 hk₀ hP' hQ' T0_pos
    exact ⟨j, hj, Or.inl hjc⟩
  · -- placement 2: (32, 16, 24)
    have hP' : (D.tile j).pts k₁ = rp 15 32 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 11 3 := by
      rw [hQ, placeThird_rp hD15 0 0 1 0 32 16 24 11 3 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    have hjc : (D.tile j).carrier = T1.carrier :=
      carrier_eq_rtri_of_pts hD15 _ hk01 hk02 hk12 hk₀ hP' hQ' T1_pos
    exact ⟨j, hj, Or.inr (Or.inl hjc)⟩
  · -- placement 3: (16, 24, 32)
    have hP' : (D.tile j).pts k₁ = rp 15 16 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 (-6) 6 := by
      rw [hQ, placeThird_rp hD15 0 0 1 0 16 24 32 (-6) 6 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    exact (escape_of D.toDissection htarget j k₂ hQ' (not_mem_rtri_of_edge2 hD15 TGT_pos (by unfold ef; norm_num))).elim
  · -- placement 4: (24, 16, 32)
    have hP' : (D.tile j).pts k₁ = rp 15 24 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 (-4) 4 := by
      rw [hQ, placeThird_rp hD15 0 0 1 0 24 16 32 (-4) 4 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    exact (escape_of D.toDissection htarget j k₂ hQ' (not_mem_rtri_of_edge2 hD15 TGT_pos (by unfold ef; norm_num))).elim
  · -- placement 5: (32, 24, 16)
    have hP' : (D.tile j).pts k₁ = rp 15 32 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 21 3 := by
      rw [hQ, placeThird_rp hD15 0 0 1 0 32 24 16 21 3 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    have hjc : (D.tile j).carrier = T2.carrier :=
      carrier_eq_rtri_of_pts hD15 _ hk01 hk02 hk12 hk₀ hP' hQ' T2_pos
    exact ⟨j, hj, Or.inr (Or.inr (Or.inl hjc))⟩
  · -- placement 6: (24, 32, 16)
    have hP' : (D.tile j).pts k₁ = rp 15 24 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 28 4 := by
      rw [hQ, placeThird_rp hD15 0 0 1 0 24 32 16 28 4 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    have hjc : (D.tile j).carrier = T3.carrier :=
      carrier_eq_rtri_of_pts hD15 _ hk01 hk02 hk12 hk₀ hP' hQ' T3_pos
    exact ⟨j, hj, Or.inr (Or.inr (Or.inr (hjc)))⟩

/-- Node 1: 1 placed tile(s), `v = (16, 0)`, `d = (1, 0)`; kills: child None, child None, escape(Q, edge 2), escape(Q, edge 2), child None, child None. -/
theorem node_1 {N : ℕ} (D : CongruentDissection N)
    (htarget : D.target.carrier = TGT.carrier) (hmodel : D.model.Congruent MODEL)
    (i0 : Fin N) (h0 : (D.tile i0).carrier = T0.carrier)
    : ∃ j, j ∉ ([i0] : List (Fin N)).toFinset ∧ ((D.tile j).carrier = T4.carrier ∨ (D.tile j).carrier = T5.carrier ∨ (D.tile j).carrier = T6.carrier ∨ (D.tile j).carrier = T7.carrier) := by
  classical
  have hyT : ∀ p ∈ TGT.carrier, 0 ≤ p 1 := fun p hp => target_y_nonneg hD15 (by norm_num) TGT_pos hp
  have hU : ∀ p, p ∈ unfilled D.toDissection ([i0] : List (Fin N)).toFinset ↔ p ∈ TGT.carrier ∧ p ∉ T0.carrier := by
    intro p; rw [mem_unfilled_iff, htarget]
    simp [h0]
  have hlex : ∀ p ∈ closure (unfilled D.toDissection ([i0] : List (Fin N)).toFinset), LexLE (rp 15 16 0) p := by
    refine hlex_of D.toDissection _ _ ((TGT.carrier ∩ halfR 15 0 1 0) ∩ (halfR 15 1 0 (-16))) ((TGT.isCompact.isClosed.inter (isClosed_halfR _ _ _ _)).inter (isClosed_halfR _ _ _ _)) ?_ ?_
    · intro p hpT hnot
      obtain ⟨X, Y, rfl⟩ := exists_rp hD15 p
      have hpT' : rp 15 X Y ∈ TGT.carrier := htarget ▸ hpT
      obtain ⟨hT0, hT1, hT2⟩ := rtri_ef_nonneg hD15 TGT_pos hpT'
      unfold ef at hT0 hT1 hT2
      have hn0 : ¬ (0 ≤ 0 * X + 16 * Y + 0 ∧ 0 ≤ (-6) * X + 6 * Y + 96 ∧ 0 ≤ 6 * X + (-22) * Y + 0) := fun h =>
        hnot i0 (by simp) (by rw [h0]; exact mem_rtri hD15 T0_pos (by unfold ef; linarith [h.1]) (by unfold ef; linarith [h.2.1]) (by unfold ef; linarith [h.2.2]))
      have hY : 0 ≤ Y := by
        by_contra hR; push_neg at hR
        linarith
      simp only [Set.mem_inter_iff, Set.mem_union, mem_halfR_rp hD15]
      refine ⟨⟨hpT', by linarith⟩, ?_⟩
      rcases le_or_gt 16 X with hX | hX
      · exact (by linarith)
      · -- the region X < xv, Y ≥ yv
        exact (hn0 ⟨by linarith, by linarith, by linarith⟩).elim
    · intro p hp
      obtain ⟨X, Y, rfl⟩ := exists_rp hD15 p
      simp only [Set.mem_inter_iff, Set.mem_union, mem_halfR_rp hD15] at hp
      obtain ⟨⟨hpT, hY⟩, hdis⟩ := hp
      obtain ⟨hT0, hT1, hT2⟩ := rtri_ef_nonneg hD15 TGT_pos hpT
      unfold ef at hT0 hT1 hT2
      refine lexLE_rp hD15 (by linarith) (fun hYe => ?_)
      rcases hdis with h <;> linarith
  have hfree : ∀ ε : ℝ, 0 < ε → ∃ t s : ℝ, 0 < t ∧ t < ε ∧ 0 < s ∧ s < ε ∧
      rp 15 16 0 + t • (rp 15 1 0 + s • perp (rp 15 1 0)) ∈ unfilled D.toDissection ([i0] : List (Fin N)).toFinset := by
    refine hfree_of hD15 (B := 4) (by norm_num) sr15_lt (τ := (1/4)) (by norm_num) _ _ _ ?_
    intro t ht htτ
    rw [pt_ccw_rp 15 hD15, hU]
    have ht2 : t ^ 2 ≤ (1/4) * t := by nlinarith [mul_le_mul_of_nonneg_left htτ ht.le]
    have ht2p : 0 < t ^ 2 := by positivity
    exact ⟨mem_rtri hD15 TGT_pos (by unfold ef; linarith) (by unfold ef; linarith) (by unfold ef; linarith), not_mem_rtri_of_edge1 hD15 T0_pos (by unfold ef; linarith)⟩
  have hblocked : ∃ δ : ℝ, 0 < δ ∧ ∀ t s : ℝ, 0 < t → t < δ → 0 < s → s < δ →
      rp 15 16 0 + t • (rp 15 1 0 - s • perp (rp 15 1 0)) ∉ unfilled D.toDissection ([i0] : List (Fin N)).toFinset := by
    exact hblocked_base hD15 D.toDissection _ (fun p hp => hyT p (htarget ▸ hp)) 16
  obtain ⟨j, hj, k₀, k₁, k₂, hk01, hk02, hk12, hk₀, ⟨c', hc', hk₁⟩, hk₂⟩ :=
    placement_completeness D.toDissection ([i0] : List (Fin N)).toFinset (rp 15 16 0) (rp 15 1 0) (rp_unit hD15 (by norm_num)) hlex hfree hblocked
  have hcong : (D.tile j).Congruent MODEL := (D.tiles_congruent j).trans hmodel
  obtain ⟨hMa, hMb, hMc⟩ := MODEL_sides
  have hj0 : j ≠ i0 := fun h => hj (by rw [h]; simp)
  rcases six_placements hcong hMa hMb hMc (rp_unit hD15 (by norm_num)) hk01 hk02 hk12 hk₀ hc' hk₁ hk₂ with
    ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩ | ⟨hP, hQ⟩
  · -- placement 1: (16, 32, 24)
    have hP' : (D.tile j).pts k₁ = rp 15 32 0 := by rw [hP, rp_add_smul]; norm_num
    have hQ' : (D.tile j).pts k₂ = rp 15 38 6 := by
      rw [hQ, placeThird_rp hD15 16 0 1 0 16 32 24 22 6 (by norm_num) (by norm_num) (by norm_num)]; norm_num
    have hjc : (D.tile j).carrier = T4.carrier :=

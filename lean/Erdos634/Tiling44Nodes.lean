theorem hD15 : (0:ℝ) < 15 := by norm_num
theorem sr15_lt : sr 15 < 4 := sr_lt hD15 (by norm_num) (by norm_num)
theorem sr15_gt1 : 1 < sr 15 := sr_gt hD15 (by norm_num) (by norm_num)

theorem TGT_pos : 0 < ef 0 0 176 0 88 24 := by unfold ef; norm_num
/-- The target `(0, 0)`, `(176, 0)`, `(88, 24·r)`. -/
noncomputable def TGT : Tri := rtri 15 hD15 0 0 176 0 88 24 TGT_pos
theorem MODEL_pos : 0 < ef 0 0 16 0 22 6 := by unfold ef; norm_num
/-- The model tile `(0, 0)`, `(16, 0)`, `(22, 6·r)`: sides `16, 24, 32`. -/
noncomputable def MODEL : Tri := rtri 15 hD15 0 0 16 0 22 6 MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 16 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 24 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 32 :=
  model_sides_rp hD15 MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)


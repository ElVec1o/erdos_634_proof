    · rw [T2_pts.1, T2_pts.2.1, T2_pts.2.2]; refine plane_ext ?_ ?_ <;> simp <;> ring
    · rw [sr_smul_perp_rp hD32, T2_pts.1, T2_pts.2.1, T2_pts.2.2]; refine plane_ext ?_ ?_ <;> simp <;> ring

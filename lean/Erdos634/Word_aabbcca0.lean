/-- Node 3: 3 placed tile(s), `v = (6, 0)`, `d = (329/729, 115/729·r)`; kills: escape(Q, edge 2), escape(Q, edge 2), overlap(tile 0), escape(Q, edge 2), escape(Q, edge 2), escape(Q, edge 2). -/
theorem node_3 {N : ℕ} (D : CongruentDissection N)
    (htarget : D.target.carrier = TGT.carrier) (hmodel : D.model.Congruent MODEL) (hbase : BaseWordHyp D.toDissection)
    (i0 i1 i2 : Fin N) (h0 : (D.tile i0).carrier = T0.carrier) (h1 : (D.tile i1).carrier = T1.carrier) (h2 : (D.tile i2).carrier = T2.carrier)
    : False := by
  classical
  have hyT : ∀ p ∈ TGT.carrier, 0 ≤ p 1 := fun p hp => target_y_nonneg hD32 (by norm_num) TGT_pos hp
  have hU : ∀ p, p ∈ unfilled D.toDissection ([i0, i1, i2] : List (Fin N)).toFinset ↔ p ∈ TGT.carrier ∧ p ∉ T0.carrier ∧ p ∉ T1.carrier ∧ p ∉ T2.carrier := by
    intro p; rw [mem_unfilled_iff, htarget]
    simp [h0, h1, h2]
  have hlex : ∀ p ∈ closure (unfilled D.toDissection ([i0, i1, i2] : List (Fin N)).toFinset), LexLE (rp 32 6 0) p := by
    refine hlex_of D.toDissection _ _ ((TGT.carrier ∩ halfR 32 0 1 0) ∩ (halfR 32 1 0 (-6))) ((TGT.isCompact.isClosed.inter (isClosed_halfR _ _ _ _)).inter (isClosed_halfR _ _ _ _)) ?_ ?_
    · intro p hpT hnot
      obtain ⟨X, Y, rfl⟩ := exists_rp hD32 p
      have hpT' : rp 32 X Y ∈ TGT.carrier := htarget ▸ hpT
      obtain ⟨hT0, hT1, hT2⟩ := rtri_ef_nonneg hD32 TGT_pos hpT'
      unfold ef at hT0 hT1 hT2
      have hn0 : ¬ (0 ≤ 0 * X + 6 * Y + 0 ∧ 0 ≤ (-5/6) * X + (5/3) * Y + 5 ∧ 0 ≤ (5/6) * X + (-23/3) * Y + 0) := fun h =>
        hnot i0 (by simp) (by rw [h0]; exact mem_rtri hD32 T0_pos (by unfold ef; linarith [h.1]) (by unfold ef; linarith [h.2.1]) (by unfold ef; linarith [h.2.2]))
      have hn1 : ¬ (0 ≤ 0 * X + 6 * Y + 0 ∧ 0 ≤ (-5/6) * X + (5/3) * Y + 10 ∧ 0 ≤ (5/6) * X + (-23/3) * Y + (-5)) := fun h =>
        hnot i1 (by simp) (by rw [h1]; exact mem_rtri hD32 T1_pos (by unfold ef; linarith [h.1]) (by unfold ef; linarith [h.2.1]) (by unfold ef; linarith [h.2.2]))
      have hn2 : ¬ (0 ≤ (-5/6) * X + (23/3) * Y + 5 ∧ 0 ≤ (-55/486) * X + (-1205/243) * Y + (460/81) ∧ 0 ≤ (230/243) * X + (-658/243) * Y + (-460/81)) := fun h =>
        hnot i2 (by simp) (by rw [h2]; exact mem_rtri hD32 T2_pos (by unfold ef; linarith [h.1]) (by unfold ef; linarith [h.2.1]) (by unfold ef; linarith [h.2.2]))
      have hY : 0 ≤ Y := by
        by_contra hR; push_neg at hR
        linarith
      simp only [Set.mem_inter_iff, Set.mem_union, mem_halfR_rp hD32]
      refine ⟨⟨hpT', by linarith⟩, ?_⟩
      rcases le_or_gt 6 X with hX | hX
      · exact (by linarith)
      · -- the region X < xv, Y ≥ yv
        exact (hn0 ⟨by linarith, by linarith, by linarith⟩).elim
    · intro p hp
      obtain ⟨X, Y, rfl⟩ := exists_rp hD32 p
      simp only [Set.mem_inter_iff, Set.mem_union, mem_halfR_rp hD32] at hp
      obtain ⟨⟨hpT, hY⟩, hdis⟩ := hp
      obtain ⟨hT0, hT1, hT2⟩ := rtri_ef_nonneg hD32 TGT_pos hpT
      unfold ef at hT0 hT1 hT2
      refine lexLE_rp hD32 (by linarith) (fun hYe => ?_)
      rcases hdis with h <;> linarith
  have hfree : ∀ ε : ℝ, 0 < ε → ∃ t s : ℝ, 0 < t ∧ t < ε ∧ 0 < s ∧ s < ε ∧
      rp 32 6 0 + t • (rp 32 (329/729) (115/729) + s • perp (rp 32 (329/729) (115/729))) ∈ unfilled D.toDissection ([i0, i1, i2] : List (Fin N)).toFinset := by
    refine hfree_of hD32 (B := 6) (by norm_num) sr32_lt (τ := (1/64)) (by norm_num) _ _ _ ?_
